# Documentation example only: replace addresses and keys before importing.
# See ../../docs/unifi-udm.md. Keep real configs outside the repository.
[Interface]
PrivateKey = REPLACE_CLIENT_PRIVATE_KEY
Address = 192.0.2.2/32
# Required by the UniFi file importer, even for handshake-only setup.
DNS = 1.1.1.1
MTU = 1280

[Peer]
PublicKey = REPLACE_HOST_PUBLIC_KEY
PresharedKey = REPLACE_PRESHARED_KEY
AllowedIPs = 192.0.2.1/32
Endpoint = 198.51.100.10:51820
PersistentKeepalive = 25
