                        "$props": {
                          "children": {
                            "$element": "ChevronLeft",
                            "$props": {
                              "className": "w-4 h-4"
                            }
                          },
                          "className": "text-green-400 md:hidden"
                        }
                      },
                      {
                        "$element": "span",
                        "$props": {
                          "children": {
                            "$element": "ChevronRight",
                            "$props": {
                              "className": "w-5 h-5"
                            }
                          },
                          "className": "text-green-400 hidden md:block"
                        }
                      }
                    ]
                  }
                },
                {
                  "$element": "Battery",
                  "$props": {
                    "className": "w-6 h-6"
                  }
                }
              ],
              "className": "inline-flex items-center h-6 flex-row-reverse md:flex-row"
            }
          },
          "iconColor": "text-green-400",
          "measurementTime": "<Date 2026-07-30T04:05:00.000Z>",
          "staleThresholdSeconds": 60,
          "title": "Battery",
          "unit": "%",
          "value": "72.5"
